<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Dashboard - Travel Agency</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>

  <!-- NAVBAR -->
  <div class="navbar">
    <a class="brand" href="/dashboard">
      <img src="/logo.svg" alt="logo" style="height:28px;">
      <span>Travel Agency</span>
    </a>

    <div class="nav-links">
      <a href="/new-trip">➕ New Trip</a>
      <a href="/trips">📋 View Trips</a>
      <a href="/drivers">🚗 Drivers</a>
    </div>

    <div class="right-controls">
      <button id="dark-toggle" class="btn ghost">Toggle Dark</button>
    </div>
  </div>

  <!-- MAIN -->
  <div class="container">
<h1 class="dashboard-title">Dashboard</h1>
    <!-- Stats -->
    <div class="card dashboard-card">
      
      <!-- ROW 1 -->
      <div class="stats-grid">
        <button type="button" class="stat-card stat-card-click" data-trip-kind="today">
          <h3>Today's Trips</h3>
          <p class="stat-value" data-value="<%= stats.todayTrips %>">0</p>
          <span class="stat-pill">Click to preview</span>
        </button>

        <button type="button" class="stat-card stat-card-click" data-trip-kind="ongoing">
          <h3>Ongoing Trips</h3>
          <p class="stat-value" data-value="<%= (ongoingTrips || []).length %>">0</p>
          <span class="stat-pill">Click to preview</span>
        </button>

        <button type="button" class="stat-card stat-card-click" data-trip-kind="upcoming">
          <h3>Upcoming Trips</h3>
          <p class="stat-value" data-value="<%= (upcomingTrips || []).length %>">0</p>
          <span class="stat-pill">Click to preview</span>
        </button>
      </div>

      <!-- ROW 2 -->
      <div class="stats-grid">
        <div class="stat-card">
          <h3>Total Trips (All Time)</h3>
          <p class="stat-value" data-value="<%= stats.totalTrips %>">0</p>
        </div>

        <div class="stat-card">
          <h3>Total Drivers</h3>
          <p class="stat-value" data-value="<%= stats.totalDrivers %>">0</p>
        </div>

        <div class="stat-card">
          <h3>Total Revenue (₹)</h3>
          <p class="stat-value" data-value="<%= Math.round(stats.revenue || 0) %>">0</p>
        </div>
      </div>
    </div>

    <!-- Charts 2x2 Grid -->
    <div class="dashboard-charts">

      <div class="chart-card">
        <h3>Driver Status</h3>
        <p class="muted small">
          Busy: <strong><%= stats.busyDrivers %></strong> ·
          Idle: <strong><%= stats.idleDrivers %></strong> ·
          Upcoming: <strong><%= stats.upcomingDrivers %></strong>
        </p>
        <canvas id="driverPieChart"></canvas>
      </div>

      <div class="chart-card">
        <h3>Trips Per Month</h3>
        <canvas id="monthlyTripsBarChart"></canvas>
      </div>

      <div class="chart-card">
        <h3>Revenue Share (By Month)</h3>
        <canvas id="revenueDoughnutChart"></canvas>
      </div>

      <div class="chart-card">
        <h3>Monthly Revenue</h3>
        <canvas id="monthlyRevenueBarChart"></canvas>
      </div>

    </div>

    <!-- Trip Timeline -->
    <div class="card timeline-card">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <h2>Upcoming Trips</h2>
        <span class="muted small">Next <strong>6</strong> trips</span>
      </div>

      <div class="timeline-list">
        <% if (!timelineTrips || timelineTrips.length === 0) { %>
          <div class="timeline-item">
            <div class="timeline-main">
              <span class="timeline-title">No upcoming trips scheduled.</span>
            </div>
          </div>
        <% } else { %>
          <% timelineTrips.forEach(t => { %>
            <div class="timeline-item">
              <div class="timeline-main">
                <div>
                  <div class="timeline-title">
                    <%= t.departure_date %> · <%= t.departure_time %> — <%= t.customer_name %>
                  </div>
                  <div class="timeline-sub">
                    <strong><%= t.departure_place %></strong> → <strong><%= t.arrival_place %></strong>
                    <% if (t.assigned_driver) { %>
                      · Driver: <%= t.assigned_driver %>
                    <% } %>
                  </div>
                </div>
                <span class="timeline-badge">UPCOMING</span>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>

  </div>

  <!-- Trip Modal (shared for Today / Ongoing / Upcoming) -->
  <div id="tripModalOverlay" class="trip-modal-overlay">
    <div class="trip-modal-box">
      <div class="trip-modal-header">
        <div>
          <h2 id="tripModalTitle" class="trip-modal-title">Trips</h2>
          <p id="tripModalSubtitle" class="trip-modal-subtitle"></p>
        </div>
        <button id="tripModalClose" type="button" class="trip-modal-close">&times;</button>
      </div>
      <div id="tripModalBody" class="trip-modal-body">
        <!-- Filled by JS -->
      </div>
    </div>
  </div>

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script>
    // ---------- Stat Number Animation ----------
    document.querySelectorAll(".stat-value").forEach(el => {
      const target = Number(el.dataset.value) || 0;
      let current = 0;
      const steps = 40;
      const increment = target / steps || 0;

      const animate = setInterval(() => {
        current += increment;
        if (current >= target) {
          current = target;
          clearInterval(animate);
        }
        el.textContent = Math.round(current).toLocaleString();
      }, 20);
    });

    // ---------- Driver Status PIE ----------
    const busyDrivers     = Number("<%= stats.busyDrivers %>");
    const idleDrivers     = Number("<%= stats.idleDrivers %>");
    const upcomingDrivers = Number("<%= stats.upcomingDrivers %>");

    const driverPieCtx = document.getElementById("driverPieChart");
    if (driverPieCtx) {
      new Chart(driverPieCtx, {
        type: "pie",
        data: {
          labels: ["Busy", "Idle", "Upcoming"],
          datasets: [{
            data: [busyDrivers, idleDrivers, upcomingDrivers],
            backgroundColor: ["#fb3c3c", "#22c55e", "#eab308"],
            hoverOffset: 8,
            borderWidth: 1
          }]
        },
        options: {
          plugins: {
            legend: { position: "bottom" },
            tooltip: {
              callbacks: {
                label: (ctx) => {
                  const total = busyDrivers + idleDrivers + upcomingDrivers || 1;
                  const count = ctx.raw;
                  const percent = ((count / total) * 100).toFixed(1);
                  return `${ctx.label}: ${count} (${percent}%)`;
                }
              }
            }
          }
        }
      });
    }

    // ---------- Trips per Month BAR ----------
    const tripsLabels = JSON.parse(`<%- JSON.stringify(stats.monthlyLabels || []) %>`);
    const tripsData   = JSON.parse(`<%- JSON.stringify(stats.monthlyTotals || []) %>`);

    const tripsCtx = document.getElementById("monthlyTripsBarChart");
    if (tripsCtx) {
      new Chart(tripsCtx, {
        type: "bar",
        data: {
          labels: tripsLabels,
          datasets: [{
            label: "Trips",
            data: tripsData,
            backgroundColor: "#6b46ff"
          }]
        },
        options: {
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true } },
          animation: { duration: 1000, easing: "easeOutCubic" }
        }
      });
    }

    // ---------- Monthly Revenue BAR + DOUGHNUT ----------
    const revLabels = JSON.parse(`<%- JSON.stringify(stats.monthlyRevenueLabels || []) %>`);
    const revData   = JSON.parse(`<%- JSON.stringify(stats.monthlyRevenueTotals || []) %>`);
    const palette   = ["#0ea5e9", "#6366f1", "#22c55e", "#eab308", "#f97316", "#ec4899"];

    const revBarCtx = document.getElementById("monthlyRevenueBarChart");
    if (revBarCtx) {
      new Chart(revBarCtx, {
        type: "bar",
        data: {
          labels: revLabels,
          datasets: [{
            label: "Revenue",
            data: revData,
            backgroundColor: revLabels.map((_, i) => palette[i % palette.length])
          }]
        },
        options: {
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true } },
          animation: { duration: 1100, easing: "easeOutCubic" }
        }
      });
    }

    const revDoughnutCtx = document.getElementById("revenueDoughnutChart");
    if (revDoughnutCtx) {
      new Chart(revDoughnutCtx, {
        type: "doughnut",
        data: {
          labels: revLabels,
          datasets: [{
            data: revData,
            backgroundColor: revLabels.map((_, i) => palette[i % palette.length]),
            hoverOffset: 8,
            borderWidth: 1
          }]
        },
        options: {
          plugins: {
            legend: { position: "bottom" },
            tooltip: {
              callbacks: {
                label: (ctx) => {
                  const total = revData.reduce((a, b) => a + b, 0) || 1;
                  const val = ctx.raw;
                  const percent = ((val / total) * 100).toFixed(1);
                  const num = typeof val === "number" ? val : Number(val || 0);
                  return `${ctx.label}: ₹${num.toFixed(2)} (${percent}%)`;
                }
              }
            }
          },
          cutout: "55%"
        }
      });
    }

    // ---------- Trip Modals (Today / Ongoing / Upcoming) ----------
    const todayTripsData    = JSON.parse(`<%- JSON.stringify(todayTrips || []) %>`);
    const ongoingTripsData  = JSON.parse(`<%- JSON.stringify(ongoingTrips || []) %>`);
    const upcomingTripsData = JSON.parse(`<%- JSON.stringify(upcomingTrips || []) %>`);

    (function() {
      const overlay   = document.getElementById("tripModalOverlay");
      const titleEl   = document.getElementById("tripModalTitle");
      const subtitleEl= document.getElementById("tripModalSubtitle");
      const bodyEl    = document.getElementById("tripModalBody");
      const closeBtn  = document.getElementById("tripModalClose");

      if (!overlay || !titleEl || !subtitleEl || !bodyEl || !closeBtn) return;

      function renderTrips(list) {
        bodyEl.innerHTML = "";
        if (!list || list.length === 0) {
          const empty = document.createElement("div");
          empty.className = "trip-modal-empty";
          empty.textContent = "No trips in this category.";
          bodyEl.appendChild(empty);
          return;
        }

        list.forEach((t) => {
          const item = document.createElement("div");
          item.className = "trip-modal-item";

          const id = t.id ?? "";
          const customerName = t.customer_name || "-";
          const customerPhone = t.phone_number || "-";
          const driverName = t.assigned_driver || "-";
          const driverPhone = t.driver_phone || "-";
          const car = t.assigned_car || "-";
          const carNo = t.car_number || "-";
          const depTime = t.departure_time || "-";
          const depPlace = t.departure_place || "-";
          const arrTime = t.arrival_time || "-";
          const arrPlace = t.arrival_place || "-";

          item.innerHTML = `
            <div style="flex:1;">
              <div class="trip-modal-mainline">
                <span class="trip-chip trip-chip-time">
                  Trip #${id} · ${depTime} → ${arrTime}
                </span>
              </div>
              <div class="trip-modal-subline" style="margin-bottom:4px;">
                <span class="trip-chip trip-chip-customer">Customer</span>
                ${customerName} · ${customerPhone}
              </div>
              <div class="trip-modal-subline" style="margin-bottom:4px;">
                <span class="trip-chip trip-chip-driver">Driver</span>
                ${driverName} · ${driverPhone}
              </div>
              <div class="trip-modal-subline" style="margin-bottom:4px;">
                <span class="trip-chip trip-chip-car">Car</span>
                ${car} · ${carNo}
              </div>
              <div class="trip-modal-subline">
                Route: <strong>${depPlace}</strong> → <strong>${arrPlace}</strong>
              </div>
            </div>
          `;
          bodyEl.appendChild(item);
        });
      }

      function openModal(kind) {
        let list = [];
        let title = "";
        let subtitle = "";

        if (kind === "today") {
          title = "Today's Trips";
          subtitle = "Trips departing today (<%= today %>)";
          list = todayTripsData;
        } else if (kind === "ongoing") {
          title = "Ongoing Trips";
          subtitle = "Trips currently between departure and arrival time.";
          list = ongoingTripsData;
        } else if (kind === "upcoming") {
          title = "Upcoming Trips";
          subtitle = "Trips scheduled to start after <%= today %>.";
          list = upcomingTripsData;
        }

        titleEl.textContent = title;
        subtitleEl.textContent = subtitle;
        renderTrips(list);

        overlay.style.display = "flex";
        document.body.classList.add("modal-open");
      }

      function closeModal() {
        overlay.style.display = "none";
        document.body.classList.remove("modal-open");
      }

      document.querySelectorAll(".stat-card-click[data-trip-kind]").forEach((card) => {
        const kind = card.getAttribute("data-trip-kind");
        card.addEventListener("click", () => openModal(kind));
      });

      closeBtn.addEventListener("click", closeModal);

      overlay.addEventListener("click", (e) => {
        if (e.target === overlay) closeModal();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && overlay.style.display === "flex") {
          closeModal();
        }
      });
    })();
  </script>

  <script src="/main.js"></script>
</body>
</html>
