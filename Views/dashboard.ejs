<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Dashboard - Travel Agency</title>
  <link rel="stylesheet" href="/styles.css">

  <style>
    :root {
      --accent: #6b46ff;
      --accent-2: #0076ff;
    }

    body {
      background: radial-gradient(circle at top, rgba(129, 140, 248, 0.32), transparent 55%),
                  radial-gradient(circle at bottom, rgba(56, 189, 248, 0.16), transparent 55%);
    }

    .card.dashboard-card {
      background: radial-gradient(circle at top left, rgba(255, 255, 255, 0.10), rgba(15, 23, 42, 0.8));
      backdrop-filter: blur(16px);
      border-radius: 20px;
      border: 1px solid rgba(148, 163, 184, 0.45);
      box-shadow: 0 22px 45px rgba(15, 23, 42, 0.45);
      position: relative;
      overflow: hidden;
    }

    .card.dashboard-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.35), rgba(14, 165, 233, 0.18));
      opacity: 0.35;
      mix-blend-mode: soft-light;
      pointer-events: none;
    }

    .card.dashboard-card > * {
      position: relative;
      z-index: 1;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 14px;
      margin-top: 18px;
    }

    .stat-card {
      padding: 14px 14px 12px;
      border-radius: 14px;
      background: rgba(15, 23, 42, 0.66);
      box-shadow: 0 8px 20px rgba(15, 23, 42, 0.4);
      border: 1px solid rgba(148, 163, 184, 0.45);
      transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease, background 0.25s ease;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .stat-card h3 {
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #9ca3af;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .stat-pill {
      font-size: 11px;
      padding: 2px 8px;
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.55);
      color: #9ca3af;
      align-self: flex-start;
      margin-top: 2px;
    }

    .stat-card-click {
      cursor: pointer;
    }

    .stat-card:hover {
      transform: translateY(-4px) scale(1.02);
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.7);
      border-color: rgba(129, 140, 248, 0.9);
      background: linear-gradient(145deg, rgba(15, 23, 42, 0.85), rgba(17, 24, 39, 0.95));
    }

    .stat-card:hover .stat-pill {
      border-color: rgba(245, 245, 255, 0.85);
      color: #e5e7eb;
    }

    .stat-value {
      font-size: 30px;
      font-weight: 900;
      color: #e5e7eb;
      margin: 0;
      transition: transform 0.25s ease;
    }

    .stat-card:hover .stat-value {
      transform: scale(1.06);
    }

    .stat-subtext {
      font-size: 11px;
      color: #9ca3af;
    }

    .charts-row {
      display: flex;
      gap: 24px;
      margin-top: 26px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .chart-card {
      flex: 1 1 420px;
      max-width: 520px;
      background: radial-gradient(circle at top left, rgba(30, 64, 175, 0.28), rgba(15, 23, 42, 0.96));
      padding: 18px;
      border-radius: 18px;
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.82);
      border: 1px solid rgba(148, 163, 184, 0.55);
      text-align: center;
      transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
      position: relative;
      overflow: hidden;
    }

    .chart-card::before {
      content: "";
      position: absolute;
      inset: -40%;
      background: radial-gradient(circle at top, rgba(251, 191, 36, 0.11), transparent 60%);
      opacity: 0.4;
      pointer-events: none;
    }

    .chart-card > * {
      position: relative;
      z-index: 1;
    }

    .chart-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 22px 55px rgba(15, 23, 42, 0.9);
      border-color: rgba(56, 189, 248, 0.85);
    }

    .chart-card canvas {
      width: 100% !important;
      height: 320px !important;
    }

    .timeline-card {
      margin-top: 26px;
      border-radius: 18px;
      background: rgba(15, 23, 42, 0.82);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(148, 163, 184, 0.55);
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.8);
    }

    .timeline-list {
      margin-top: 12px;
      border-top: 1px solid rgba(55, 65, 81, 0.9);
    }

    .timeline-item {
      display: flex;
      flex-direction: column;
      padding: 10px 4px;
      border-bottom: 1px solid rgba(55, 65, 81, 0.8);
    }

    .timeline-main {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
    }

    .timeline-title {
      font-weight: 600;
      color: #e5e7eb;
      font-size: 14px;
    }

    .timeline-sub {
      font-size: 12px;
      color: #9ca3af;
    }

    .timeline-badge {
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      border: 1px solid rgba(148, 163, 184, 0.7);
      background: rgba(37, 99, 235, 0.2);
      color: #bfdbfe;
    }

    .theme-picker {
      margin-left: auto;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: var(--muted);
    }

    .theme-picker select {
      padding: 6px 8px;
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.7);
      background: rgba(15, 23, 42, 0.8);
      color: #e5e7eb;
      font-size: 13px;
    }

    /* Trip Modal (Today's / Ongoing / Upcoming) */
    .trip-modal-overlay {
      position: fixed;
      inset: 0;
      background: radial-gradient(circle at top, rgba(15, 23, 42, 0.95), rgba(15, 23, 42, 0.90));
      backdrop-filter: blur(20px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 60;
      padding: 16px;
    }

    .trip-modal-box {
      width: 100%;
      max-width: 780px;
      max-height: 80vh;
      background: radial-gradient(circle at top left, rgba(30, 64, 175, 0.45), rgba(15, 23, 42, 0.96));
      border-radius: 20px;
      border: 1px solid rgba(148, 163, 184, 0.7);
      box-shadow: 0 22px 55px rgba(15, 23, 42, 0.92);
      padding: 18px 20px 16px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .trip-modal-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 14px;
      margin-bottom: 10px;
    }

    .trip-modal-title {
      font-size: 18px;
      font-weight: 700;
      color: #e5e7eb;
      margin: 0;
    }

    .trip-modal-subtitle {
      font-size: 13px;
      color: #9ca3af;
      margin: 2px 0 0;
    }

    .trip-modal-close {
      background: rgba(15, 23, 42, 0.9);
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.7);
      color: #e5e7eb;
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 18px;
      line-height: 1;
      transition: background 0.25s ease, transform 0.2s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

    .trip-modal-close:hover {
      background: rgba(239, 68, 68, 0.85);
      border-color: rgba(252, 165, 165, 0.9);
      box-shadow: 0 0 0 1px rgba(248, 113, 113, 0.8);
      transform: scale(1.02);
    }

    .trip-modal-body {
      margin-top: 6px;
      padding-top: 6px;
      border-top: 1px solid rgba(55, 65, 81, 0.85);
      overflow-y: auto;
      padding-right: 6px;
    }

    .trip-modal-item {
      padding: 10px 4px;
      border-bottom: 1px solid rgba(55, 65, 81, 0.8);
      display: flex;
      gap: 10px;
    }

    .trip-modal-item:last-child {
      border-bottom: none;
    }

    .trip-chip {
      font-size: 11px;
      padding: 2px 8px;
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.7);
      color: #e5e7eb;
      margin-right: 6px;
      white-space: nowrap;
    }

    .trip-chip.trip-chip-time {
      background: rgba(59, 130, 246, 0.22);
      border-color: rgba(59, 130, 246, 0.75);
    }

    .trip-chip.trip-chip-driver {
      background: rgba(34, 197, 94, 0.14);
      border-color: rgba(34, 197, 94, 0.7);
    }

    .trip-chip.trip-chip-customer {
      background: rgba(234, 179, 8, 0.14);
      border-color: rgba(234, 179, 8, 0.7);
    }

    .trip-chip.trip-chip-car {
      background: rgba(236, 72, 153, 0.14);
      border-color: rgba(236, 72, 153, 0.7);
    }

    .trip-modal-mainline {
      font-size: 13px;
      color: #e5e7eb;
      margin-bottom: 4px;
    }

    .trip-modal-subline {
      font-size: 12px;
      color: #9ca3af;
    }

    .trip-modal-empty {
      padding: 12px 4px;
      font-size: 13px;
      color: #9ca3af;
    }

    @media (max-width: 900px) {
      .chart-card canvas {
        height: 260px !important;
      }
      .trip-modal-box {
        padding: 14px;
      }
    }
  </style>
</head>

<body>

  <!-- NAVBAR -->
  <div class="navbar">
    <a class="brand" href="/dashboard">
      <img src="/logo.svg" alt="logo" style="height:28px;">
      <span>Travel Agency</span>
    </a>

    <div class="nav-links">
      <a href="/new-trip">➕ New Trip</a>
      <a href="/trips">📋 View Trips</a>
      <a href="/drivers">🚗 Drivers</a>
    </div>

    <div class="right-controls">
      <div class="theme-picker">
        Theme:
        <select id="theme-picker-select">
          <option value="purple">Purple</option>
          <option value="blue">Blue</option>
          <option value="emerald">Emerald</option>
        </select>
      </div>
      <button id="dark-toggle" class="btn ghost">Toggle Dark</button>
    </div>
  </div>

  <!-- MAIN -->
  <div class="container">

    <!-- Stats -->
    <div class="card dashboard-card">
      <h1>Dashboard</h1>

      <div class="stats-grid">
        <!-- Today’s Trips (click → modal) -->
        <button type="button" class="stat-card stat-card-click" data-trip-kind="today">
          <h3>Today's Trips</h3>
          <p class="stat-value" data-value="<%= stats.todayTrips %>">0</p>
          <span class="stat-pill">Click to view trips</span>
          <span class="stat-subtext">Trips departing on <strong><%= today %></strong></span>
        </button>

        <!-- Ongoing Trips (click → modal) -->
        <button type="button" class="stat-card stat-card-click" data-trip-kind="ongoing">
          <h3>Ongoing Trips</h3>
          <p class="stat-value" data-value="<%= (ongoingTrips || []).length %>">0</p>
          <span class="stat-pill">Click to see running</span>
          <span class="stat-subtext">Currently between departure & arrival</span>
        </button>

        <!-- Upcoming Trips (click → modal) -->
        <button type="button" class="stat-card stat-card-click" data-trip-kind="upcoming">
          <h3>Upcoming Trips</h3>
          <p class="stat-value" data-value="<%= (upcomingTrips || []).length %>">0</p>
          <span class="stat-pill">Click to preview next</span>
          <span class="stat-subtext">Trips starting after <strong><%= today %></strong></span>
        </button>

        <!-- Total Trips -->
        <div class="stat-card">
          <h3>Total Trips (All Time)</h3>
          <p class="stat-value" data-value="<%= stats.totalTrips %>">0</p>
          <span class="stat-subtext">All trips stored in the system</span>
        </div>

        <!-- Total Drivers -->
        <div class="stat-card">
          <h3>Total Drivers</h3>
          <p class="stat-value" data-value="<%= stats.totalDrivers %>">0</p>
          <span class="stat-subtext">
            Busy: <strong><%= stats.busyDrivers %></strong> ·
            Idle: <strong><%= stats.idleDrivers %></strong> ·
            Upcoming: <strong><%= stats.upcomingDrivers %></strong>
          </span>
        </div>

        <!-- Total Revenue -->
        <div class="stat-card">
          <h3>Total Revenue (₹)</h3>
          <p class="stat-value" data-value="<%= Math.round(stats.revenue || 0) %>">0</p>
          <span class="stat-subtext">Rounded from ₹<%= Number(stats.revenue || 0).toFixed(2) %></span>
        </div>
      </div>
    </div>

    <!-- Charts Row 1: Driver status + Trips per month -->
    <div class="charts-row">
      <div class="chart-card">
        <h3>Driver Status</h3>
        <p class="muted small">
          Busy: <strong><%= stats.busyDrivers %></strong> ·
          Idle: <strong><%= stats.idleDrivers %></strong> ·
          Upcoming: <strong><%= stats.upcomingDrivers %></strong>
        </p>
        <canvas id="driverPieChart"></canvas>
      </div>

      <div class="chart-card">
        <h3>Trips Per Month</h3>
        <canvas id="monthlyTripsBarChart"></canvas>
      </div>
    </div>

    <!-- Charts Row 2: Revenue doughnut + Revenue bar -->
    <div class="charts-row" style="margin-top:22px;">
      <div class="chart-card">
        <h3>Revenue Share (By Month)</h3>
        <canvas id="revenueDoughnutChart"></canvas>
      </div>

      <div class="chart-card">
        <h3>Monthly Revenue</h3>
        <canvas id="monthlyRevenueBarChart"></canvas>
      </div>
    </div>

    <!-- Trip Timeline -->
    <div class="card timeline-card">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <h2>Upcoming Trips</h2>
        <span class="muted small">Next <strong>6</strong> trips</span>
      </div>

      <div class="timeline-list">
        <% if (!timelineTrips || timelineTrips.length === 0) { %>
          <div class="timeline-item">
            <div class="timeline-main">
              <span class="timeline-title">No upcoming trips scheduled.</span>
            </div>
          </div>
        <% } else { %>
          <% timelineTrips.forEach(t => { %>
            <div class="timeline-item">
              <div class="timeline-main">
                <div>
                  <div class="timeline-title">
                    <%= t.departure_date %> · <%= t.departure_time %> — <%= t.customer_name %>
                  </div>
                  <div class="timeline-sub">
                    <strong><%= t.departure_place %></strong> → <strong><%= t.arrival_place %></strong>
                    <% if (t.assigned_driver) { %>
                      · Driver: <%= t.assigned_driver %>
                    <% } %>
                  </div>
                </div>
                <span class="timeline-badge">UPCOMING</span>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>

  </div>

  <!-- Trip Modal (shared for Today / Ongoing / Upcoming) -->
  <div id="tripModalOverlay" class="trip-modal-overlay">
    <div class="trip-modal-box">
      <div class="trip-modal-header">
        <div>
          <h2 id="tripModalTitle" class="trip-modal-title">Trips</h2>
          <p id="tripModalSubtitle" class="trip-modal-subtitle"></p>
        </div>
        <button id="tripModalClose" type="button" class="trip-modal-close">&times;</button>
      </div>
      <div id="tripModalBody" class="trip-modal-body">
        <!-- Filled by JS -->
      </div>
    </div>
  </div>

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script>
    // ---------- Theme Color Picker ----------
    (function() {
      const select = document.getElementById('theme-picker-select');
      const root = document.documentElement;
      const saved = localStorage.getItem('ta_theme');
      if (saved) {
        select.value = saved;
        applyTheme(saved);
      }

      select.addEventListener('change', () => {
        const v = select.value;
        applyTheme(v);
        localStorage.setItem('ta_theme', v);
      });

      function applyTheme(name) {
        if (name === 'blue') {
          root.style.setProperty('--accent',  '#2563eb');
          root.style.setProperty('--accent-2','#38bdf8');
        } else if (name === 'emerald') {
          root.style.setProperty('--accent',  '#059669');
          root.style.setProperty('--accent-2','#22c55e');
        } else {
          root.style.setProperty('--accent',  '#6b46ff');
          root.style.setProperty('--accent-2','#0076ff');
        }
      }
    })();

    // ---------- Stat Number Animation ----------
    document.querySelectorAll(".stat-value").forEach(el => {
      const target = Number(el.dataset.value) || 0;
      let current = 0;
      const steps = 40;
      const increment = target / steps || 0;

      const animate = setInterval(() => {
        current += increment;
        if (current >= target) {
          current = target;
          clearInterval(animate);
        }
        el.textContent = Math.round(current).toLocaleString();
      }, 20);
    });

    // ---------- Driver Status PIE ----------
    const busyDrivers     = Number("<%= stats.busyDrivers %>");
    const idleDrivers     = Number("<%= stats.idleDrivers %>");
    const upcomingDrivers = Number("<%= stats.upcomingDrivers %>");

    const driverPieCtx = document.getElementById("driverPieChart");
    if (driverPieCtx) {
      new Chart(driverPieCtx, {
        type: "pie",
        data: {
          labels: ["Busy", "Idle", "Upcoming"],
          datasets: [{
            data: [busyDrivers, idleDrivers, upcomingDrivers],
            backgroundColor: ["#fb3c3c", "#22c55e", "#eab308"],
            hoverOffset: 8,
            borderWidth: 1
          }]
        },
        options: {
          plugins: {
            legend: { position: "bottom" },
            tooltip: {
              callbacks: {
                label: (ctx) => {
                  const total = busyDrivers + idleDrivers + upcomingDrivers || 1;
                  const count = ctx.raw;
                  const percent = ((count / total) * 100).toFixed(1);
                  return `${ctx.label}: ${count} (${percent}%)`;
                }
              }
            }
          }
        }
      });
    }

    // ---------- Trips per Month BAR ----------
    const tripsLabels = <%- JSON.stringify(stats.monthlyLabels || []) %>;
    const tripsData   = <%- JSON.stringify(stats.monthlyTotals || []) %>;

    const tripsCtx = document.getElementById("monthlyTripsBarChart");
    if (tripsCtx) {
      new Chart(tripsCtx, {
        type: "bar",
        data: {
          labels: tripsLabels,
          datasets: [{
            label: "Trips",
            data: tripsData,
            backgroundColor: "#6b46ff"
          }]
        },
        options: {
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true } },
          animation: { duration: 1000, easing: "easeOutCubic" }
        }
      });
    }

    // ---------- Monthly Revenue BAR + DOUGHNUT ----------
    const revLabels = <%- JSON.stringify(stats.monthlyRevenueLabels || []) %>;
    const revData   = <%- JSON.stringify(stats.monthlyRevenueTotals || []) %>;
    const palette   = ["#0ea5e9", "#6366f1", "#22c55e", "#eab308", "#f97316", "#ec4899"];

    const revBarCtx = document.getElementById("monthlyRevenueBarChart");
    if (revBarCtx) {
      new Chart(revBarCtx, {
        type: "bar",
        data: {
          labels: revLabels,
          datasets: [{
            label: "Revenue",
            data: revData,
            backgroundColor: revLabels.map((_, i) => palette[i % palette.length])
          }]
        },
        options: {
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true } },
          animation: { duration: 1100, easing: "easeOutCubic" }
        }
      });
    }

    const revDoughnutCtx = document.getElementById("revenueDoughnutChart");
    if (revDoughnutCtx) {
      new Chart(revDoughnutCtx, {
        type: "doughnut",
        data: {
          labels: revLabels,
          datasets: [{
            data: revData,
            backgroundColor: revLabels.map((_, i) => palette[i % palette.length]),
            hoverOffset: 8,
            borderWidth: 1
          }]
        },
        options: {
          plugins: {
            legend: { position: "bottom" },
            tooltip: {
              callbacks: {
                label: (ctx) => {
                  const total = revData.reduce((a, b) => a + b, 0) || 1;
                  const val = ctx.raw;
                  const percent = ((val / total) * 100).toFixed(1);
                  const num = typeof val === "number" ? val : Number(val || 0);
                  return `${ctx.label}: ₹${num.toFixed(2)} (${percent}%)`;
                }
              }
            }
          },
          cutout: "55%"
        }
      });
    }

    // ---------- Trip Modals (Today / Ongoing / Upcoming) ----------
    const todayTripsData    = <%- JSON.stringify(todayTrips || []) %>;
    const ongoingTripsData  = <%- JSON.stringify(ongoingTrips || []) %>;
    const upcomingTripsData = <%- JSON.stringify(upcomingTrips || []) %>;

    (function() {
      const overlay   = document.getElementById("tripModalOverlay");
      const titleEl   = document.getElementById("tripModalTitle");
      const subtitleEl= document.getElementById("tripModalSubtitle");
      const bodyEl    = document.getElementById("tripModalBody");
      const closeBtn  = document.getElementById("tripModalClose");

      if (!overlay || !titleEl || !subtitleEl || !bodyEl || !closeBtn) return;

      function renderTrips(list) {
        bodyEl.innerHTML = "";
        if (!list || list.length === 0) {
          const empty = document.createElement("div");
          empty.className = "trip-modal-empty";
          empty.textContent = "No trips in this category.";
          bodyEl.appendChild(empty);
          return;
        }

        list.forEach((t) => {
          const item = document.createElement("div");
          item.className = "trip-modal-item";

          const id = t.id ?? "";
          const customerName = t.customer_name || "-";
          const customerPhone = t.phone_number || "-";
          const driverName = t.assigned_driver || "-";
          const driverPhone = t.driver_phone || "-";
          const car = t.assigned_car || "-";
          const carNo = t.car_number || "-";
          const depTime = t.departure_time || "-";
          const depPlace = t.departure_place || "-";
          const arrTime = t.arrival_time || "-";
          const arrPlace = t.arrival_place || "-";

          item.innerHTML = `
            <div style="flex:1;">
              <div class="trip-modal-mainline">
                <span class="trip-chip trip-chip-time">
                  Trip #${id} · ${depTime} → ${arrTime}
                </span>
              </div>
              <div class="trip-modal-subline" style="margin-bottom:4px;">
                <span class="trip-chip trip-chip-customer">Customer</span>
                ${customerName} · ${customerPhone}
              </div>
              <div class="trip-modal-subline" style="margin-bottom:4px;">
                <span class="trip-chip trip-chip-driver">Driver</span>
                ${driverName} · ${driverPhone}
              </div>
              <div class="trip-modal-subline" style="margin-bottom:4px;">
                <span class="trip-chip trip-chip-car">Car</span>
                ${car} · ${carNo}
              </div>
              <div class="trip-modal-subline">
                Route: <strong>${depPlace}</strong> → <strong>${arrPlace}</strong>
              </div>
            </div>
          `;
          bodyEl.appendChild(item);
        });
      }

      function openModal(kind) {
        let list = [];
        let title = "";
        let subtitle = "";

        if (kind === "today") {
          title = "Today's Trips";
          subtitle = "Trips departing today (<%= today %>)";
          list = todayTripsData;
        } else if (kind === "ongoing") {
          title = "Ongoing Trips";
          subtitle = "Trips currently between departure and arrival time.";
          list = ongoingTripsData;
        } else if (kind === "upcoming") {
          title = "Upcoming Trips";
          subtitle = "Trips scheduled to start after <%= today %>.";
          list = upcomingTripsData;
        }

        titleEl.textContent = title;
        subtitleEl.textContent = subtitle;
        renderTrips(list);

        overlay.style.display = "flex";
        document.body.classList.add("modal-open");
      }

      function closeModal() {
        overlay.style.display = "none";
        document.body.classList.remove("modal-open");
      }

      document.querySelectorAll(".stat-card-click[data-trip-kind]").forEach((card) => {
        const kind = card.getAttribute("data-trip-kind");
        card.addEventListener("click", () => openModal(kind));
      });

      closeBtn.addEventListener("click", closeModal);

      overlay.addEventListener("click", (e) => {
        if (e.target === overlay) closeModal();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && overlay.style.display === "flex") {
          closeModal();
        }
      });
    })();
  </script>

  <script src="/main.js"></script>
</body>
</html>
