<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Dashboard - Travel Agency</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>

  <!-- NAVBAR -->
  <div class="navbar">
    <a class="brand" href="/dashboard">
      <img src="/logo.svg" alt="logo" style="height:28px;">
      <span>Dashboard</span>
    </a>

    <div class="nav-links">
      <a href="/new-trip">➕ New Trip</a>
      <a href="/trips">📋 View Trips</a>
      <a href="/drivers">🚗 Drivers</a>
    </div>

    <div class="right-controls">
      <button id="dark-toggle" class="btn ghost">Toggle Dark</button>
    </div>
  </div>

  <!-- MAIN -->
  <div class="container">

    <!-- Stats -->
    <div class="card dashboard-card">
      <!-- Row 1 -->
      <div class="stats-grid">
        <button type="button" class="stat-card stat-card-click" data-trip-kind="today">
          <h3>Today's Trips</h3>
          <p class="stat-value" data-value="<%= stats.todayTrips %>">0</p>
          <span class="stat-pill">Click to preview</span>
        </button>

        <button type="button" class="stat-card stat-card-click" data-trip-kind="ongoing">
          <h3>Ongoing Trips</h3>
          <p class="stat-value" data-value="<%= (ongoingTrips || []).length %>">0</p>
          <span class="stat-pill">Click to preview</span>
        </button>

        <button type="button" class="stat-card stat-card-click" data-trip-kind="upcoming">
          <h3>Upcoming Trips</h3>
          <p class="stat-value" data-value="<%= (upcomingTrips || []).length %>">0</p>
          <span class="stat-pill">Click to preview</span>
        </button>
      </div>

      <!-- Row 2 -->
      <div class="stats-grid">
        <div class="stat-card">
          <h3>Total Trips (All Time)</h3>
          <p class="stat-value" data-value="<%= stats.totalTrips %>">0</p>
        </div>

        <div class="stat-card">
          <h3>Total Drivers</h3>
          <p class="stat-value" data-value="<%= stats.totalDrivers %>">0</p>
        </div>

        <div class="stat-card">
          <h3>Total Revenue (₹)</h3>
          <p class="stat-value" data-value="<%= Math.round(stats.revenue || 0) %>">0</p>
        </div>
      </div>
    </div>

    <!-- Charts Grid -->
    <div class="dashboard-charts">

      <!-- DRIVER STATUS -->
      <div class="chart-card">
        <h3>Driver Status</h3>
        <p class="muted small">
          Busy: <strong><%= stats.busyDrivers %></strong> ·
          Idle: <strong><%= stats.idleDrivers %></strong> ·
          Upcoming: <strong><%= stats.upcomingDrivers %></strong>
        </p>
        <p class="muted small">
          <em>Tip: Click a slice to see drivers in that status.</em>
        </p>
        <canvas id="driverPieChart"></canvas>
      </div>

      <!-- TRIPS / MONTH -->
      <div class="chart-card">
        <h3>Trips Per Month</h3>
        <p class="muted small">
          <em>Tip: Click a bar to see all trips for that month.</em>
        </p>
        <canvas id="monthlyTripsBarChart"></canvas>
      </div>

      <!-- REVENUE SHARE -->
      <div class="chart-card">
        <h3>Revenue Share (By Month)</h3>
        <canvas id="revenueDoughnutChart"></canvas>
      </div>

      <!-- MONTHLY REVENUE -->
      <div class="chart-card">
        <h3>Monthly Revenue</h3>
        <canvas id="monthlyRevenueBarChart"></canvas>
      </div>

    </div>

    <!-- Timeline -->
    <div class="card timeline-card">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <h2>Upcoming Trips</h2>
        <span class="muted small">Next <strong>6</strong> trips</span>
      </div>

      <div class="timeline-list">
        <% if (!timelineTrips || timelineTrips.length === 0) { %>
          <div class="timeline-item">
            <div class="timeline-main">
              <span class="timeline-title">No upcoming trips scheduled.</span>
            </div>
          </div>
        <% } else { %>
          <% timelineTrips.forEach(t => { %>
            <div class="timeline-item">
              <div class="timeline-main">
                <div>
                  <div class="timeline-title">
                    <%= t.departure_date %> · <%= t.departure_time %> — <%= t.customer_name %>
                  </div>
                  <div class="timeline-sub">
                    <strong><%= t.departure_place %></strong> → <strong><%= t.arrival_place %></strong>
                    <% if (t.assigned_driver) { %>
                      · Driver: <%= t.assigned_driver %>
                    <% } %>
                  </div>
                </div>
                <span class="timeline-badge">UPCOMING</span>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>

  </div> <!-- /container -->

  <!-- Trip Type Modal (Today / Ongoing / Upcoming) -->
  <div id="tripModalOverlay" class="trip-modal-overlay">
    <div class="trip-modal-box">
      <div class="trip-modal-header">
        <div>
          <h2 id="tripModalTitle" class="trip-modal-title">Trips</h2>
          <p id="tripModalSubtitle" class="trip-modal-subtitle"></p>
        </div>
        <button id="tripModalClose" type="button" class="trip-modal-close">&times;</button>
      </div>
      <div id="tripModalBody" class="trip-modal-body"></div>
    </div>
  </div>

  <!-- Driver Status Modal -->
  <div id="driverModalOverlay" class="trip-modal-overlay">
    <div class="trip-modal-box">
      <div class="trip-modal-header">
        <div>
          <h2 id="driverModalTitle">Drivers</h2>
          <p id="driverModalSubtitle" class="trip-modal-subtitle"></p>
        </div>
        <button id="driverModalClose" type="button" class="trip-modal-close">&times;</button>
      </div>
      <div id="driverModalBody" class="trip-modal-body"></div>
    </div>
  </div>

  <!-- Month Trips Modal -->
  <div id="monthTripsModal" class="trip-modal-overlay">
    <div class="trip-modal-box">
      <div class="trip-modal-header">
        <div>
          <h2 id="monthTripsTitle">Trips in Month</h2>
          <p id="monthTripsSubtitle" class="trip-modal-subtitle"></p>
        </div>
        <button id="monthTripsClose" type="button" class="trip-modal-close">&times;</button>
      </div>
      <div id="monthTripsBody" class="trip-modal-body"></div>
    </div>
  </div>

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script>
    // =====================================================
    // STAT NUMBER ANIMATION
    // =====================================================
    document.querySelectorAll(".stat-value").forEach((el) => {
      const target = Number(el.dataset.value) || 0;
      let current = 0;
      const steps = 40;
      const increment = target / steps || 0;

      const animate = setInterval(() => {
        current += increment;
        if (current >= target) {
          current = target;
          clearInterval(animate);
        }
        el.textContent = Math.round(current).toLocaleString();
      }, 20);
    });

    // =====================================================
    // DRIVER STATUS PIE CHART
    // =====================================================
    const busyDrivers     = Number("<%= stats.busyDrivers %>");
    const idleDrivers     = Number("<%= stats.idleDrivers %>");
    const upcomingDrivers = Number("<%= stats.upcomingDrivers %>");

    const driverPieCtx = document.getElementById("driverPieChart");
    let driverPieChart = null;

    if (driverPieCtx) {
      driverPieChart = new Chart(driverPieCtx, {
        type: "pie",
        data: {
          labels: ["Busy", "Idle", "Upcoming"],
          datasets: [{
            data: [busyDrivers, idleDrivers, upcomingDrivers],
            backgroundColor: ["#fb3c3c", "#22c55e", "#eab308"],
            hoverOffset: 8,
            borderWidth: 1
          }]
        },
        options: {
          plugins: {
            legend: { position: "bottom" },
            tooltip: {
              callbacks: {
                label: (ctx) => {
                  const total = busyDrivers + idleDrivers + upcomingDrivers || 1;
                  const count = ctx.raw;
                  const percent = ((count / total) * 100).toFixed(1);
                  return `${ctx.label}: ${count} (${percent}%)`;
                }
              }
            }
          }
        }
      });
    }

    // =====================================================
    // DRIVER STATUS MODAL
    // =====================================================
    const driversData = JSON.parse(`<%- JSON.stringify(driversData || []) %>`);

    (function () {
      const overlay  = document.getElementById("driverModalOverlay");
      const bodyEl   = document.getElementById("driverModalBody");
      const titleEl  = document.getElementById("driverModalTitle");
      const subEl    = document.getElementById("driverModalSubtitle");
      const closeBtn = document.getElementById("driverModalClose");

      if (!overlay || !bodyEl || !closeBtn) return;

      function phoneUI(label, phone) {
        const safePhone = phone || "";
        const clean = safePhone.replace(/[^\d]/g, "");
        if (!clean) return `${label}: ${safePhone || "-"}`;
        return `
          ${label}:
          <a class="call-link" href="tel:${clean}">${safePhone}</a>
          <a class="wa-icon" href="https://wa.me/${clean}" target="_blank" title="Message on WhatsApp">💬</a>
        `;
      }

      function openDriverModal(status) {
        const list = (driversData || []).filter((d) => d.status === status);
        bodyEl.innerHTML = "";

        if (!list.length) {
          bodyEl.innerHTML = `<div class="trip-modal-empty">No drivers found in this status.</div>`;
          titleEl.textContent = `${status.toUpperCase()} DRIVERS`;
          subEl.textContent = "Total: 0";
          overlay.style.display = "flex";
          document.body.classList.add("modal-open");
          return;
        }

        list.forEach((d) => {
          const t = d.currentTrip || d.upcomingTrip;
          const item = document.createElement("div");
          item.className = "trip-modal-item";

          let tripBlock = "";

          if (status === "idle" || !t) {
            tripBlock = `
              <div class="trip-modal-subline">
                <strong>Status:</strong> Idle — No current booking
              </div>
            `;
          } else {
            const depPlace = t.departure_place || "-";
            const arrPlace = t.arrival_place || "-";
            const depDate  = t.departure_date || "-";
            const depTime  = t.departure_time || "-";
            const custPhone= t.phone_number || "";

            tripBlock = `
              <div class="trip-modal-subline">
                <strong>Route:</strong> ${depPlace} → ${arrPlace}
              </div>
              <div class="trip-modal-subline">
                <strong>Departure:</strong> ${depDate} ${depTime}
              </div>
              <div class="trip-modal-subline">
                ${phoneUI("Customer", custPhone)}
              </div>
            `;
          }

          item.innerHTML = `
            <div style="flex:1;">
              <div class="trip-modal-mainline">
                <span class="trip-chip trip-chip-driver">${d.name || "Unnamed Driver"}</span>
              </div>
              <div class="trip-modal-subline">
                ${phoneUI("Phone", d.phone || "")}
              </div>
              <div class="trip-modal-subline">
                <span class="trip-chip trip-chip-car">Car</span>
                ${d.car || "-"} · ${d.car_number || "-"}
              </div>
              ${tripBlock}
            </div>
          `;
          bodyEl.appendChild(item);
        });

        titleEl.textContent = `${status.toUpperCase()} DRIVERS`;
        subEl.textContent = `Total: ${list.length}`;

        overlay.style.display = "flex";
        document.body.classList.add("modal-open");
      }

      // Pie slice click -> open driver modal
      if (driverPieCtx && driverPieChart) {
        driverPieCtx.addEventListener("click", (e) => {
          const points = driverPieChart.getElementsAtEventForMode(
            e,
            "nearest",
            { intersect: true },
            true
          );
          if (!points.length) return;
          const idx = points[0].index;
          const statusMap = ["busy", "idle", "upcoming"];
          const status = statusMap[idx] || "idle";
          openDriverModal(status);
        });
      }

      closeBtn.addEventListener("click", () => {
        overlay.style.display = "none";
        document.body.classList.remove("modal-open");
      });

      overlay.addEventListener("click", (e) => {
        if (e.target === overlay) {
          overlay.style.display = "none";
          document.body.classList.remove("modal-open");
        }
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && overlay.style.display === "flex") {
          overlay.style.display = "none";
          document.body.classList.remove("modal-open");
        }
      });
    })();

    // =====================================================
    // TRIPS PER MONTH BAR + MONTH TRIPS MODAL HOOK
    // =====================================================
    const tripsLabels = JSON.parse(`<%- JSON.stringify(stats.monthlyLabels || []) %>`);
    const tripsData   = JSON.parse(`<%- JSON.stringify(stats.monthlyTotals || []) %>`);

    const tripsCtx = document.getElementById("monthlyTripsBarChart");
    let tripsChart = null;

    if (tripsCtx) {
      tripsChart = new Chart(tripsCtx, {
        type: "bar",
        data: {
          labels: tripsLabels,
          datasets: [{
            label: "Trips",
            data: tripsData,
            backgroundColor: "#6b46ff"
          }]
        },
        options: {
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true } },
          animation: { duration: 1000, easing: "easeOutCubic" },
          onClick: (evt, elements) => {
            if (!elements.length) return;
            const idx = elements[0].index;
            const month = tripsLabels[idx];
            if (month) openMonthTripsModal(month);
          }
        }
      });
    }

    // =====================================================
    // MONTHLY REVENUE BAR + REVENUE DOUGHNUT
    // =====================================================
    const revLabels = JSON.parse(`<%- JSON.stringify(stats.monthlyRevenueLabels || []) %>`);
    const revData   = JSON.parse(`<%- JSON.stringify(stats.monthlyRevenueTotals || []) %>`);
    const palette   = ["#0ea5e9", "#6366f1", "#22c55e", "#eab308", "#f97316", "#ec4899"];

    const revBarCtx = document.getElementById("monthlyRevenueBarChart");
    if (revBarCtx) {
      new Chart(revBarCtx, {
        type: "bar",
        data: {
          labels: revLabels,
          datasets: [{
            label: "Revenue",
            data: revData,
            backgroundColor: revLabels.map((_, i) => palette[i % palette.length])
          }]
        },
        options: {
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true } },
          animation: { duration: 1100, easing: "easeOutCubic" }
        }
      });
    }

    const revDoughnutCtx = document.getElementById("revenueDoughnutChart");
    if (revDoughnutCtx) {
      new Chart(revDoughnutCtx, {
        type: "doughnut",
        data: {
          labels: revLabels,
          datasets: [{
            data: revData,
            backgroundColor: revLabels.map((_, i) => palette[i % palette.length]),
            hoverOffset: 8,
            borderWidth: 1
          }]
        },
        options: {
          plugins: {
            legend: { position: "bottom" },
            tooltip: {
              callbacks: {
                label: (ctx) => {
                  const total = revData.reduce((a, b) => a + b, 0) || 1;
                  const val = ctx.raw;
                  const percent = ((val / total) * 100).toFixed(1);
                  const num = typeof val === "number" ? val : Number(val || 0);
                  return `${ctx.label}: ₹${num.toFixed(2)} (${percent}%)`;
                }
              }
            }
          },
          cutout: "55%"
        }
      });
    }

    // =====================================================
    // TRIP MODALS (TODAY / ONGOING / UPCOMING)
    // =====================================================
    const todayTripsData    = JSON.parse(`<%- JSON.stringify(todayTrips || []) %>`);
    const ongoingTripsData  = JSON.parse(`<%- JSON.stringify(ongoingTrips || []) %>`);
    const upcomingTripsData = JSON.parse(`<%- JSON.stringify(upcomingTrips || []) %>`);

    (function () {
      const overlay    = document.getElementById("tripModalOverlay");
      const titleEl    = document.getElementById("tripModalTitle");
      const subtitleEl = document.getElementById("tripModalSubtitle");
      const bodyEl     = document.getElementById("tripModalBody");
      const closeBtn   = document.getElementById("tripModalClose");

      if (!overlay || !titleEl || !subtitleEl || !bodyEl || !closeBtn) return;

      function phoneUI(name, phone) {
        const safeName = name || "-";
        const safePhone = phone || "-";
        const cleanPhone = (phone || "").replace(/[^0-9]/g, "");

        if (!cleanPhone) {
          return `${safeName} · ${safePhone}`;
        }

        return `
          ${safeName} · 
          <a class="call-link" href="tel:${cleanPhone}">${safePhone}</a>
          <a class="wa-icon" title="Message on WhatsApp" href="https://wa.me/${cleanPhone}" target="_blank">💬</a>
        `;
      }

      function renderTrips(list) {
        bodyEl.innerHTML = "";
        if (!list || list.length === 0) {
          const empty = document.createElement("div");
          empty.className = "trip-modal-empty";
          empty.textContent = "No trips in this category.";
          bodyEl.appendChild(empty);
          return;
        }

        list.forEach((t) => {
          const item = document.createElement("div");
          item.className = "trip-modal-item";

          const id            = t.id ?? "";
          const customerName  = t.customer_name || "-";
          const customerPhone = t.phone_number || "-";
          const driverName    = t.assigned_driver || "-";
          const driverPhone   = t.driver_phone || "-";
          const car           = t.assigned_car || "-";
          const carNo         = t.car_number || "-";
          const depTime       = t.departure_time || "-";
          const depPlace      = t.departure_place || "-";
          const arrTime       = t.arrival_time || "-";
          const arrPlace      = t.arrival_place || "-";

          item.innerHTML = `
            <div style="flex:1;">
              <div class="trip-modal-mainline">
                <span class="trip-chip trip-chip-time">
                  Trip #${id} · ${depTime} → ${arrTime}
                </span>
              </div>
              <div class="trip-modal-subline" style="margin-bottom:4px;">
                <span class="trip-chip trip-chip-customer">Customer</span>
                ${phoneUI(customerName, customerPhone)}
              </div>
              <div class="trip-modal-subline" style="margin-bottom:4px;">
                <span class="trip-chip trip-chip-driver">Driver</span>
                ${phoneUI(driverName, driverPhone)}
              </div>
              <div class="trip-modal-subline" style="margin-bottom:4px;">
                <span class="trip-chip trip-chip-car">Car</span>
                ${car} · ${carNo}
              </div>
              <div class="trip-modal-subline">
                Route: <strong>${depPlace}</strong> → <strong>${arrPlace}</strong>
              </div>
            </div>
          `;
          bodyEl.appendChild(item);
        });
      }

      function openModal(kind) {
        let list = [];
        let title = "";
        let subtitle = "";

        if (kind === "today") {
          title = "Today's Trips";
          subtitle = "Trips departing today (<%= today %>)";
          list = todayTripsData;
        } else if (kind === "ongoing") {
          title = "Ongoing Trips";
          subtitle = "Trips currently between departure and arrival time.";
          list = ongoingTripsData;
        } else if (kind === "upcoming") {
          title = "Upcoming Trips";
          subtitle = "Trips scheduled to start after <%= today %>.";
          list = upcomingTripsData;
        }

        titleEl.textContent = title;
        subtitleEl.textContent = subtitle;
        renderTrips(list);

        overlay.style.display = "flex";
        document.body.classList.add("modal-open");
      }

      function closeModal() {
        overlay.style.display = "none";
        document.body.classList.remove("modal-open");
      }

      document
        .querySelectorAll(".stat-card-click[data-trip-kind]")
        .forEach((card) => {
          const kind = card.getAttribute("data-trip-kind");
          card.addEventListener("click", () => openModal(kind));
        });

      closeBtn.addEventListener("click", closeModal);

      overlay.addEventListener("click", (e) => {
        if (e.target === overlay) closeModal();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && overlay.style.display === "flex") {
          closeModal();
        }
      });
    })();

    // =====================================================
    // MONTH TRIPS MODAL (OPENED FROM BAR CHART)
    // =====================================================
    (function () {
      const overlay  = document.getElementById("monthTripsModal");
      const bodyEl   = document.getElementById("monthTripsBody");
      const titleEl  = document.getElementById("monthTripsTitle");
      const subEl    = document.getElementById("monthTripsSubtitle");
      const closeBtn = document.getElementById("monthTripsClose");

      if (!overlay || !bodyEl || !closeBtn) return;

      function renderMonthTrips(month, list) {
        bodyEl.innerHTML = "";
        if (!list || list.length === 0) {
          bodyEl.innerHTML = `<div class="trip-modal-empty">No trips in this month.</div>`;
          subEl.textContent = "Total: 0";
          return;
        }

        subEl.textContent = `Total: ${list.length}`;
        list.forEach((t) => {
          const item = document.createElement("div");
          item.className = "trip-modal-item";

          const driverName  = t.assigned_driver || "-";
          const driverPhone = t.driver_phone || "";
          const car         = t.assigned_car || "-";
          const carNo       = t.car_number || "-";
          const depDate     = t.departure_date || "-";
          const depPlace    = t.departure_place || "-";
          const arrDate     = t.arrival_date || "-";
          const arrPlace    = t.arrival_place || "-";

          const cleanPhone = driverPhone.replace(/[^\d]/g, "");

          item.innerHTML = `
            <div style="flex:1;">
              <div class="trip-modal-mainline">
                <span class="trip-chip trip-chip-driver">${driverName}</span>
              </div>
              <div class="trip-modal-subline">
                Driver Phone:
                ${
                  cleanPhone
                    ? `<a class="call-link" href="tel:${cleanPhone}">${driverPhone}</a>
                       <a class="wa-icon" href="https://wa.me/${cleanPhone}" target="_blank">💬</a>`
                    : "-"
                }
              </div>
              <div class="trip-modal-subline">
                <span class="trip-chip trip-chip-car">Car</span>
                ${car} · ${carNo}
              </div>
              <div class="trip-modal-subline">
                <strong>Departure:</strong> ${depDate} — ${depPlace}
              </div>
              <div class="trip-modal-subline">
                <strong>Arrival:</strong> ${arrDate} — ${arrPlace}
              </div>
            </div>
          `;

          bodyEl.appendChild(item);
        });
      }

      window.openMonthTripsModal = function (month) {
        titleEl.textContent = `Trips in ${month}`;
        subEl.textContent = "";
        bodyEl.innerHTML = `<div class="trip-modal-empty">Loading...</div>`;

        overlay.style.display = "flex";
        document.body.classList.add("modal-open");

        fetch(`/api/month-trips?month=${encodeURIComponent(month)}`)
          .then((res) => res.json())
          .then((list) => {
            renderMonthTrips(month, list || []);
          })
          .catch(() => {
            bodyEl.innerHTML = `<div class="trip-modal-empty">Failed to load trips for this month.</div>`;
          });
      };

      function closeModal() {
        overlay.style.display = "none";
        document.body.classList.remove("modal-open");
      }

      closeBtn.addEventListener("click", closeModal);
      overlay.addEventListener("click", (e) => {
        if (e.target === overlay) closeModal();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && overlay.style.display === "flex") {
          closeModal();
        }
      });
    })();
  </script>

  <!-- Shared UI utilities (dark mode, delete modal, autocomplete, etc.) -->
  <script src="/main.js"></script>
</body>
</html>
