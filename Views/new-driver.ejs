<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>New Driver</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>

  <body>
    <!-- NAVBAR -->
    <div class="navbar">
      <a class="brand" href="/dashboard">
        <img src="/logo.svg" alt="logo" style="height: 28px" />
        <span>Travel Agency</span>
      </a>

      <div class="nav-links">
        <a href="/drivers">🚗 Drivers</a>
        <a class="active" href="/drivers/new">➕ Add Driver</a>
      </div>

      <div class="right-controls">
        <button id="dark-toggle" class="btn ghost">Toggle Dark</button>
      </div>
    </div>

    <!-- MAIN -->
    <div class="container">
      <div class="card">
        <div
          style="
            display: flex;
            justify-content: space-between;
            align-items: center;
          "
        >
          <h2>Add New Driver</h2>
          <a href="javascript:history.back()" class="btn ghost">⬅ Back</a>
        </div>

        <form
          action="/drivers/new"
          method="POST"
          enctype="multipart/form-data"
          style="margin-top: 14px"
        >
          <div class="form-grid">
            <div class="form-row">
              <label>Name</label>
              <input type="text" name="name" required />
            </div>

            <div class="form-row">
              <label>Phone</label>
              <input type="text" name="phone" />
            </div>

            <div class="form-row">
              <label>Car</label>
              <input type="text" name="car" />
            </div>

            <div class="form-row">
              <label>Car Number</label>
              <input type="text" name="car_number" />
            </div>

            <div class="form-row">
              <label>License</label>
              <input type="text" name="license" />
            </div>

            <div class="form-row">
              <label>Driver's License Image</label>
              <input
                type="file"
                name="license_image"
                accept="image/*"
                onchange="previewImage('license_image_preview', this)"
              />

              <img
                id="license_image_preview"
                style="max-width: 200px; display: none"
              />
            </div>

            <div class="form-row">
              <label>Car Image (Front) (Optional)</label>
              <input
                type="file"
                name="car_image_front"
                accept="image/*"
                onchange="previewImage('car_image_front_preview', this)"
              />

              <img
                id="car_image_front_preview"
                style="max-width: 200px; display: none"
              />
            </div>

            <div class="form-row">
              <label>Car Image (Back) (Optional)</label>
              <input
                type="file"
                name="car_image_back"
                accept="image/*"
                onchange="previewImage('car_image_back_preview', this)"
              />
              <img
                id="car_image_back_preview"
                style="max-width: 200px; display: none"
              />
            </div>

            <div class="form-row">
              <label>Car Image (Left) (Optional)</label>
              <input
                type="file"
                name="car_image_left"
                accept="image/*"
                onchange="previewImage('car_image_left_preview', this)"
              />
              <img
                id="car_image_left_preview"
                style="max-width: 200px; display: none"
              />
            </div>

            <div class="form-row">
              <label>Car Image (Right) (Optional)</label>
              <input
                type="file"
                name="car_image_right"
                accept="image/*"
                onchange="previewImage('car_image_right_preview', this)"
              />
              <img
                id="car_image_right_preview"
                style="max-width: 200px; display: none"
              />
            </div>

            <div class="form-row" style="grid-column: 1 / -1">
              <label>Notes</label>
              <textarea name="notes" style="height: 80px"></textarea>
            </div>
          </div>

          <!-- ACTION BUTTONS -->
          <div style="margin-top: 18px">
            <button class="btn" type="submit">Save Driver</button>
          </div>
        </form>
      </div>
    </div>

    <script src="/main.js"></script>
  </body>
</html>

<script>
  window.addEventListener('pageshow', function (event) {
    if (event.persisted) {
      window.location.reload();
    }
  });

  function previewImage(imgId, input) {
    const img = document.getElementById(imgId);
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function (e) {
        img.src = e.target.result;
        img.style.display = 'block';
      };
      reader.readAsDataURL(input.files[0]);
    }
  }
</script>
