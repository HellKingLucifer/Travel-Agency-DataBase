<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>All Trips</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <!-- NAVBAR -->
  <div class="navbar">
    <a class="brand" href="/dashboard">
       <img src="/logo.svg" alt="logo" style="height: 28px" />
      <span>Travel Agency</span>
    </a>

    <div class="nav-links">
      <a href="/new-trip">➕ New Trip</a>
      <a class="active" href="/trips">📋 View Trips</a>
      <a href="/drivers">🚗 Drivers</a>
    </div>

    <div class="right-controls">
      <a class="btn ghost" href="/export/csv">Export CSV</a>
      <button id="dark-toggle" class="btn ghost">Toggle Dark</button>
    </div>
  </div>

  <!-- MAIN CONTENT -->
  <div class="container container-trips">
  <div class="card">

      <!-- TITLE + SERVER-SIDE SEARCH FORM -->
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <h2>All Trips</h2>

        <form action="/trips" method="GET" class="controls" style="display:flex; gap:10px;">
          <div style="position: relative; display: flex; align-items: center;">
            <img src="/icons/search.svg" style="position: absolute; left: 10px; width: 16px; opacity: 0.5;">
            <input
              type="text"
              name="search"
              placeholder="Search..."
              value="<%= search || '' %>"
              style="min-width:300px; padding-left: 30px;"
            >
          </div>
          <button class="btn ghost" type="submit">Search</button>
        </form>
      </div>

      <!-- TABLE LIST -->
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Customer</th>
              <th>Phone</th>
              <th>Referral</th>
              <th>Trip Type</th>
              <th>Departure</th>
              <th>Arrival</th>
              <th>Driver</th>
              <th>Car</th>
              <th>Fee</th>
              <th>Toll</th>
              <th>Driver Payment</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            <% if (!trips || trips.length === 0) { %>
              <tr>
                <td colspan="14" style="padding:20px; text-align:center;">No trips found.</td>
              </tr>
            <% } else { %>
              <% trips.forEach(trip => { %>
                <tr class="trip-row" data-includes-toll="<%= trip.includes_toll %>">
                  <!-- Clickable ID -->
                  <td class="col-id">
                    <a href="/trips/<%= trip.id %>" class="link-id"><strong><%= trip.id %></strong></a>
                  </td>

                  <!-- Clickable Customer -->
                  <td class="col-customer">
                    <a class="customer-name" href="/trips/<%= trip.id %>">
                      <%= trip.customer_name %>
                    </a>
                    <% if (trip.customer_id) { %>
                      <div class="muted small"><%= trip.customer_id %></div>
                    <% } %>
                  </td>

                  <td class="col-phone"><%= trip.phone_number %></td>
                  
                  <td class="col-referral">
                    <% if (trip.referal) { %>
                      <a href="/referral/<%= trip.referal %>" class="link-referral"><%= trip.referal %></a>
                    <% } else { %>
                      -
                    <% } %>
                  </td>

                  <!-- Trip Type -->
                  <td>
                    <span class="badge <%= trip.trip_type === 'round_trip' ? 'badge-round' : 'badge-oneway' %>">
                      <%= trip.trip_type === 'round_trip' ? 'Round Trip' : 'One Way' %>
                    </span>
                  </td>

                  <!-- Departure -->
                  <td class="col-departure">
                    <div class="place">
                      <img src="/icons/departure.svg" class="inline-icon">
                      <strong><%= trip.departure_place %></strong>
                    </div>
                    <div class="muted small">
                      <%= trip.departure_date %> <%= trip.departure_time %>
                    </div>
                  </td>

                  <!-- Arrival -->
                  <td class="col-arrival">
                    <div class="place">
                      <img src="/icons/arrival.svg" class="inline-icon">
                      <strong><%= trip.arrival_place %></strong>
                    </div>
                    <div class="muted small">
                      <%= trip.arrival_date %> <%= trip.arrival_time %>
                    </div>
                  </td>

                  <td class="col-driver"><%= trip.assigned_driver || "-" %></td>
                  <td class="col-car"><%= trip.assigned_car || "-" %></td>

                  <td class="col-fee">₹<%= Number(trip.travelling_fee).toFixed(2) %></td>

                  <!-- Toll -->
                  <td class="col-toll">
                    <% if (trip.includes_toll) { %>
                      <span class="badge badge-yes">
                        <img src="/icons/toll.svg" class="badge-icon"> Yes
                      </span>
                    <% } else { %>
                      <span class="badge badge-no">
                        <img src="/icons/toll.svg" class="badge-icon"> No
                      </span>
                    <% } %>
                  </td>

                  <!-- Driver Payment -->
                  <td class="col-driver-payment">
                    <% if (trip.driver_payment_status === 'paid') { %>
                      <span class="badge badge-yes">Paid</span>
                    <% } else { %>
                      <span class="badge badge-no">Not Paid</span>
                    <% } %>
                  </td>

                  <td class="col-created"><%= trip.created_at %></td>

                  <!-- Actions -->
                  <td class="col-actions">
                    <a class="action-btn edit-btn" href="/trips/<%= trip.id %>/edit">
                      <img src="/icons/edit.svg"> <span class="btn-text">Edit</span>
                    </a>

                    <button
                      class="action-btn del-btn open-delete-modal"
                      data-id="<%= trip.id %>"
                      data-entity="trip"
                    >
                      <img src="/icons/delete.svg"> <span class="btn-text">Delete</span>
                    </button>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- PAGINATION -->
      <div style="margin-top:20px; display:flex; gap:10px; align-items:center;">
        <% if (typeof currentPage !== "undefined" && currentPage > 1) { %>
          <a
            class="btn ghost"
            href="/trips?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(search || '') %>">
            ⬅ Prev
          </a>
        <% } %>

        <% if (typeof currentPage !== "undefined" && typeof totalPages !== "undefined") { %>
          <span class="page-indicator">
            Page <%= currentPage %> of <%= totalPages %>
          </span>
        <% } %>

        <% if (typeof currentPage !== "undefined" && currentPage < totalPages) { %>
          <a
            class="btn ghost"
            href="/trips?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(search || '') %>">
            Next ➡
          </a>
        <% } %>
      </div>

    </div>
  </div>

  <!-- DELETE CONFIRMATION MODAL -->
  <div id="deleteModal" class="trip-modal-overlay" style="display:none;">
    <div class="trip-modal-box">
      <h3>Delete Trip</h3>
      <p>Are you sure you want to delete this trip? </p>

      <div class="modal-actions">
        <button id="cancelDelete" class="btn ghost">Cancel</button>
        <button id="confirmDeleteBtn" class="btn delete-btn" type="button">Delete</button>
      </div>
    </div>
  </div>

  <script src="/main.js"></script>
</body>
</html>
