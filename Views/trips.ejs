<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>All Trips - Travel Agency</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 20px;
      }
      table {
        border-collapse: collapse;
        width: 100%;
        margin-top: 10px;
      }
      th,
      td {
        border: 1px solid #ccc;
        padding: 8px;
        font-size: 14px;
        text-align: left;
      }
      th {
        background: #f4f4f4;
      }
      .nav {
        margin-bottom: 15px;
      }
      .nav a {
        margin-right: 10px;
        text-decoration: none;
        color: #0077cc;
      }
      .nav a:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <div class="nav">
      <a href="/new-trip">New Trip</a>
      <a href="/trips">View All Trips</a>
    </div>

    <h1>All Trips</h1>

    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Customer Name</th>
          <th>Phone</th>
          <th>Customer ID</th>
          <th>Departure Place</th>
          <th>Departure Date/Time</th>
          <th>Arrival Place</th>
          <th>Arrival Date/Time</th>
          <th>Assigned Driver</th>
          <th>Assigned Car</th>
          <th>Travelling Fee</th>
          <th>Toll Included?</th>
          <th>Created At</th>
        </tr>
      </thead>
      <tbody>
        <% if (!trips || trips.length === 0) { %>
          <tr>
            <td colspan="13">No trips found.</td>
          </tr>
        <% } else { %>
          <% trips.forEach(trip => { %>
            <tr>
              <td><%= trip.id %></td>
              <td><%= trip.customer_name %></td>
              <td><%= trip.phone_number %></td>
              <td><%= trip.customer_id %></td>
              <td><%= trip.departure_place %></td>
              <td><%= trip.departure_date %> <%= trip.departure_time %></td>
              <td><%= trip.arrival_place %></td>
              <td><%= trip.arrival_date %> <%= trip.arrival_time %></td>
              <td><%= trip.assigned_driver %></td>
              <td><%= trip.assigned_car %></td>
              <td><%= Number(trip.travelling_fee).toFixed(2) %></td>
              <td><%= trip.includes_toll ? "Yes" : "No" %></td>
              <td><%= trip.created_at %></td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </body>
</html>
