<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>All Trips</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <!-- NAVBAR -->
  <div class="navbar">
    <a class="brand" href="/dashboard">
      <img src="/icons/dashboard.svg" alt="logo" style="height:26px;">
      <span>Travel Agency</span>
    </a>

    <div class="nav-links">
      <a href="/new-trip">➕ New Trip</a>
      <a class="active" href="/trips">📋 View Trips</a>
       <a href="/drivers">🚗 Drivers</a>
    </div>

    <div class="right-controls">
      <a class="btn ghost" href="/export/csv">Export CSV</a>
      <button id="dark-toggle" class="btn ghost">Toggle Dark</button>
    </div>
  </div>

  <!-- MAIN CONTENT -->
  <div class="container">
    <div class="card">

      <!-- TITLE + SERVER-SIDE SEARCH FORM -->
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <h2>All Trips</h2>

        <form action="/trips" method="GET" class="controls" style="display:flex; gap:10px;">
          <div style="display:flex; align-items:center; gap:8px;">
            <img src="/icons/search.svg" style="width:16px;">
            <input
              type="text"
              name="search"
              placeholder="Search..."
              value="<%= search %>"
              style="min-width:300px;"
            >
          </div>
          <button class="btn ghost" type="submit">Search</button>
        </form>
      </div>

      <!-- TABLE LIST -->
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Customer</th>
              <th>Phone</th>
              <th>Departure</th>
              <th>Arrival</th>
              <th>Driver</th>
              <th>Car</th>
              <th>Fee</th>
              <th>Toll</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            <% if (!trips || trips.length === 0) { %>
              <tr>
                <td colspan="11" style="padding:20px; text-align:center;">No trips found.</td>
              </tr>
            <% } else { %>

              <% trips.forEach(trip => { %>
                <tr class="trip-row">
                  <!-- Clickable ID -->
                  <td class="col-id">
                    <a href="/trips/<%= trip.id %>" class="link-id"><strong><%= trip.id %></strong></a>
                  </td>

                  <!-- Clickable Customer -->
                  <td class="col-customer">
                    <a class="customer-name" href="/trips/<%= trip.id %>">
                      <%= trip.customer_name %>
                    </a>
                    <% if (trip.customer_id) { %>
                      <div class="muted small"><%= trip.customer_id %></div>
                    <% } %>
                  </td>

                  <td class="col-phone"><%= trip.phone_number %></td>

                  <td class="col-departure">
                    <div class="place">
                      <img src="/icons/departure.svg" class="inline-icon">
                      <strong><%= trip.departure_place %></strong>
                    </div>
                    <div class="muted small"><%= trip.departure_date %> <%= trip.departure_time %></div>
                  </td>

                  <td class="col-arrival">
                    <div class="place">
                      <img src="/icons/arrival.svg" class="inline-icon">
                      <strong><%= trip.arrival_place %></strong>
                    </div>
                    <div class="muted small"><%= trip.arrival_date %> <%= trip.arrival_time %></div>
                  </td>

                  <td class="col-driver"><%= trip.assigned_driver || "-" %></td>
                  <td class="col-car"><%= trip.assigned_car || "-" %></td>

                  <td class="col-fee">₹<%= Number(trip.travelling_fee).toFixed(2) %></td>

                  <td class="col-toll">
                    <% if (trip.includes_toll) { %>
                      <span class="badge badge-yes">
                        <img src="/icons/toll.svg" class="badge-icon"> Yes
                      </span>
                    <% } else { %>
                      <span class="badge badge-no">
                        <img src="/icons/toll.svg" class="badge-icon"> No
                      </span>
                    <% } %>
                  </td>

                  <td class="col-created"><%= trip.created_at %></td>

                  <td class="col-actions">
                    <a class="action-btn edit-btn" href="/trips/<%= trip.id %>/edit">
                      <img src="/icons/edit.svg"> <span class="btn-text">Edit</span>
                    </a>

                    <button class="action-btn del-btn open-delete-modal" data-id="<%= trip.id %>">
                      <img src="/icons/delete.svg"> <span class="btn-text">Delete</span>
                    </button>
                  </td>
                </tr>
              <% }) %>

            <% } %>
          </tbody>
        </table>
      </div>

      <!-- PAGINATION -->
      <div style="margin-top:20px; display:flex; gap:10px; align-items:center;">
        <% if (currentPage > 1) { %>
          <a class="btn ghost" href="/trips?page=<%= currentPage - 1 %>&search=<%= search %>">⬅ Prev</a>
        <% } %>

        <span class="page-indicator">
          Page <%= currentPage %> of <%= totalPages %>
        </span>

        <% if (currentPage < totalPages) { %>
          <a class="btn ghost" href="/trips?page=<%= currentPage + 1 %>&search=<%= search %>">Next ➡</a>
        <% } %>
      </div>

    </div>
  </div>

  <!-- DELETE CONFIRMATION MODAL -->
  <div id="deleteModal" class="modal-overlay" style="display:none;">
    <div class="modal-box">
      <h3>Delete Trip</h3>
      <p>Are you sure you want to delete this trip? This action cannot be undone.</p>

      <div class="modal-actions">
        <button id="cancelDelete" class="btn ghost">Cancel</button>
        <form id="confirmDeleteForm" method="POST">
          <button class="btn delete-btn" type="submit">Delete</button>
        </form>
      </div>
    </div>
  </div>

  <script src="/main.js"></script>
</body>
</html>
