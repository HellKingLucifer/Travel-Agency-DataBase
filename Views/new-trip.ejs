<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>New Trip - Travel Agency</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 20px;
      }
      form {
        max-width: 600px;
      }
      label {
        display: block;
        margin-top: 10px;
        font-weight: bold;
      }
      input,
      select {
        width: 100%;
        padding: 8px;
        margin-top: 4px;
        box-sizing: border-box;
      }
      .row {
        display: flex;
        gap: 10px;
      }
      .row > div {
        flex: 1;
      }
      button {
        margin-top: 15px;
        padding: 10px 15px;
        cursor: pointer;
      }
      .nav {
        margin-bottom: 15px;
      }
      .nav a {
        margin-right: 10px;
        text-decoration: none;
        color: #0077cc;
      }
      .nav a:hover {
        text-decoration: underline;
      }
      h1, h3 {
        margin-top: 20px;
      }
    </style>
  </head>
  <body>
    <!-- Simple navigation -->
    <div class="nav">
      <a href="/new-trip">New Trip</a>
      <a href="/trips">View All Trips</a>
    </div>

    <h1>Create New Trip</h1>

    <form action="/new-trip" method="POST">
      <label>
        Customer Name
        <input type="text" name="customer_name" required />
      </label>

      <label>
        Phone Number
        <input type="text" name="phone_number" required />
      </label>

      <label>
        Customer ID (ID proof / internal ID)
        <input type="text" name="customer_id" />
      </label>

      <h3>Departure</h3>

      <label>
        Departure Place
        <input type="text" name="departure_place" required />
      </label>

      <div class="row">
        <div>
          <label>
            Departure Date
            <input type="date" name="departure_date" required />
          </label>
        </div>
        <div>
          <label>
            Departure Time
            <input type="time" name="departure_time" required />
          </label>
        </div>
      </div>

      <h3>Arrival</h3>

      <label>
        Arrival Place
        <input type="text" name="arrival_place" required />
      </label>

      <div class="row">
        <div>
          <label>
            Arrival Date
            <input type="date" name="arrival_date" required />
          </label>
        </div>
        <div>
          <label>
            Arrival Time
            <input type="time" name="arrival_time" required />
          </label>
        </div>
      </div>

      <h3>Assignment</h3>

      <label>
        Assigned Driver
        <input type="text" name="assigned_driver" />
      </label>

      <label>
        Assigned Car
        <input type="text" name="assigned_car" />
      </label>

      <h3>Fee</h3>

      <label>
        Travelling Fee (amount)
        <input type="number" step="0.01" name="travelling_fee" required />
      </label>

      <label>
        Toll Option
        <select name="toll_option" required>
          <option value="include">Including Toll</option>
          <option value="exclude">Excluding Toll</option>
        </select>
      </label>

      <button type="submit">Save Trip</button>
    </form>
  </body>
</html>
