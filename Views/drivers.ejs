<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Drivers</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>

  <!-- NAVBAR -->
  <div class="navbar">
    <a class="brand" href="/dashboard">
       <img src="/logo.svg" alt="logo" style="height: 28px" />
      <span>Travel Agency</span>
    </a>

    <div class="nav-links">
      <a href="/new-trip">➕ New Trip</a>
      <a href="/trips">📋 View Trips</a>
      <a class="active" href="/drivers">🚗 Drivers</a>
    </div>

    <div class="right-controls">
      <button id="dark-toggle" class="btn ghost">Toggle Dark</button>
    </div>
  </div>

  <!-- MAIN CONTENT -->
  <div class="container">
    <div class="card">

      <!-- HEADER -->
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <h2>Drivers</h2>

        <div class="controls" style="display:flex; gap:12px;">
          <!-- SEARCH BAR -->
          <form action="/drivers" method="GET" style="display:flex; gap:10px; align-items:center;">
            <div style="display:flex; align-items:center; gap:8px;">
              <img src="/icons/search.svg" class="inline-icon" style="width:16px;">
              <input
                type="text"
                name="search"
                placeholder="Search drivers..."
                value="<%= search || '' %>"
                style="min-width:250px;"
              >
            </div>
            <button class="btn ghost" type="submit">Search</button>
          </form>

          <!-- ADD DRIVER -->
          <a class="btn" href="/drivers/new">
            ➕ Add Driver
          </a>
        </div>
      </div>

      <!-- TABLE -->
      <div class="table-wrap" style="margin-top:18px;">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Phone</th>
              <th>Car</th>
              <th>Car Number</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            <% if (!drivers || drivers.length === 0) { %>
              <tr>
                <td colspan="6" style="padding:20px; text-align:center;">
                  No drivers found.
                </td>
              </tr>
            <% } else { %>
              <% drivers.forEach(d => { %>
                <tr>
                  <td><strong><%= d.id %></strong></td>
                  <td><%= d.name %></td>
                  <td><%= d.phone || "-" %></td>
                  <td><%= d.car || "-" %></td>
                  <td><%= d.car_number || "-" %></td>

                  <td style="white-space:nowrap;">
                    <!-- EDIT -->
                    <a class="action-btn edit-btn" href="/drivers/<%= d.id %>/edit">
                      <img src="/icons/edit.svg" class="inline-icon"> Edit
                    </a>

                    <!-- DELETE (uses modal) -->
                    <button
                      class="action-btn del-btn open-delete-modal"
                      data-id="<%= d.id %>"
                      data-entity="driver"
                    >
                      <img src="/icons/delete.svg" class="inline-icon"> Delete
                    </button>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- DELETE CONFIRMATION MODAL -->
  <div id="deleteModal" class="trip-modal-overlay" style="display:none;">
    <div class="trip-modal-box" style="width: 400px; max-width: 90%;">
      <h3>Delete Driver</h3>
      <p>Are you sure ?</p>

      <div id="confirmDeleteForm" style="width: 100%;">
        <div class="modal-actions">
          <button id="cancelDelete" type="button" class="btn ghost">Cancel</button>
          <button id="confirmDeleteBtn" class="btn del-btn" type="button">Delete</button>
        </div>
      </div>
    </div>
  </div>

  <script src="/main.js"></script>
</body>
</html>

<script>
  window.addEventListener("pageshow", function (event) {
    if (event.persisted) {
      window.location.reload();
    }
  });
</script>
