<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Edit Driver</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>

  <body>
    <!-- NAVBAR -->
    <div class="navbar">
      <a class="brand" href="/dashboard">
        <img src="/logo.svg" alt="logo" style="height: 28px" />
        <span>Travel Agency</span>
      </a>

      <div class="nav-links">
        <a href="/drivers" class="active">🚗 Drivers</a>
      </div>

      <div class="right-controls">
        <button id="dark-toggle" class="btn ghost">Toggle Dark</button>
      </div>
    </div>

    <!-- MAIN -->
    <div class="container">
      <div class="card">
        <h2>Edit Driver — <%= driver.name %></h2>

        <form
  action="/drivers/<%= driver.id %>/edit"
  method="POST"
  enctype="multipart/form-data"
  style="margin-top: 14px"
>
  <div class="form-grid">

    <!-- NAME -->
    <div class="form-row">
      <label>Name</label>
      <input type="text" name="name" value="<%= driver.name %>" required />
    </div>

    <!-- PHONE -->
    <div class="form-row">
      <label>Phone</label>
      <input type="text" name="phone" value="<%= driver.phone %>" />
    </div>

    <!-- CAR -->
    <div class="form-row">
      <label>Car</label>
      <input type="text" name="car" value="<%= driver.car %>" />
    </div>

    <!-- CAR NUMBER -->
    <div class="form-row">
      <label>Car Number</label>
      <input type="text" name="car_number" value="<%= driver.car_number %>" />
    </div>

    <!-- LICENSE -->
    <div class="form-row">
      <label>License</label>
      <input type="text" name="license" value="<%= driver.license %>" />
    </div>

    <!-- LICENSE IMAGE -->
    <div class="form-row">
  <label>Driver License Image</label>

  <% if (driver.license_image) { %>
    <img
      src="<%= driver.license_image %>"
      id="license_image_preview"
      style="max-width: 200px; display: block; margin-bottom: 6px"
    />
    <small class="muted">(Current image — upload to replace)</small>
  <% } else { %>
    <img
      id="license_image_preview"
      style="max-width: 200px; display: none; margin-bottom: 6px"
    />
  <% } %>

  <input
    type="file"
    name="license_image"
    accept="image/*"
    onchange="previewImage('license_image_preview', this)"
  />
</div>


  
    <!-- CAR IMAGES -->
   <% const carImages = [
   ['Front', 'car_image_front'],
   ['Back', 'car_image_back'],
   ['Left', 'car_image_left'],
   ['Right', 'car_image_right']
   ]; %>

     <% carImages.forEach(([label, field]) => { %>
     <div class="form-row">
     <label>Car Image (<%= label %>)</label>

     <% if (driver[field]) { %>
      <img
        src="<%= driver[field] %>"
        id="<%= field %>_preview"
        style="max-width: 200px; display: block; margin-bottom: 6px;"
      />
      <small class="muted">(Current image — upload to replace)</small>
     <% } else { %>
      <img
        id="<%= field %>_preview"
        style="max-width: 200px; display: none; margin-bottom: 6px;"
      />
     <% } %>

     <input
      type="file"
      name="<%= field %>"
      accept="image/*"
      onchange="previewImage('<%= field %>_preview', this)"
     />
     </div>
     <% }) %>


      <!-- NOTES -->
      <div class="form-row" style="grid-column: 1 / -1">
      <label>Notes</label>
      <textarea name="notes" style="min-height: 90px"><%= driver.notes %></textarea>
      </div>

      </div>

      <div style="margin-top: 18px">
      <button class="btn" type="submit">Update Driver</button>
      <a class="btn ghost" href="/drivers" style="margin-left: 10px">Cancel</a>
      </div>
      </form>

      </div>
    </div>

    <script src="/main.js"></script>
  </body>
</html>

<script>
  function previewImage(imgId, input) {
    const img = document.getElementById(imgId);
    if (!img || !input.files || !input.files[0]) return;

    const reader = new FileReader();
    reader.onload = e => {
      img.src = e.target.result;
      img.style.display = "block";
    };
    reader.readAsDataURL(input.files[0]);
  }
</script>

<script>
  window.addEventListener('pageshow', function (event) {
    if (event.persisted) {
      window.location.reload();
    }
  });
</script>
