<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Trip Details</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <!-- NAVBAR -->
  <div class="navbar">
    <a class="brand" href="/dashboard">
       <img src="/logo.svg" alt="logo" style="height: 28px" />
      <span>Travel Agency</span>
    </a>

    <div class="nav-links">
      <a href="/new-trip">➕ New Trip</a>
      <a href="/trips">📋 View Trips</a>
       <a href="/drivers">🚗 Drivers</a>
    </div>

    <div class="right-controls">
      <button id="dark-toggle" class="btn ghost">Toggle Dark</button>
    </div>
  </div>

  <!-- MAIN CONTENT -->
  <div class="container">
    <div class="card">

      <div style="display: flex; justify-content: space-between; align-items: center;">
        <h2>Trip Details</h2>
        <a href="javascript:history.back()" class="btn ghost">⬅ Back</a>
      </div>
      <p class="muted small">Trip ID: <strong><%= trip.id %></strong></p>
     <p class="muted small">Trip Type:
       <span class="badge <%= trip.trip_type === 'round_trip' ? 'badge-round' : 'badge-oneway' %>">
         <%= trip.trip_type === 'round_trip' ? 'Round Trip' : 'One Way' %>
       </span>
     </p>

      <div class="details-grid">

        <!-- CUSTOMER BOX -->
        <div class="detail-box">
          <h3>Customer Details</h3>
          <p><strong>Name:</strong> <%= trip.customer_name %></p>
          <p><strong>Phone:</strong> <%= trip.phone_number %></p>
          <% if (trip.customer_id) { %>
            <p><strong>Customer ID:</strong> <%= trip.customer_id %></p>
          <% } %>
          <% if (trip.referral) { %>
            <p><strong>Referral:</strong> <%= trip.referral %></p>
          <% } %>
        </div>

        <!-- ROUTE BOX -->
        <div class="detail-box">
          <h3>Travel Route</h3>

          <p>
            <img src="/icons/departure.svg" class="inline-icon">
            <strong>From:</strong> <%= trip.departure_place %>
          </p>
          <p class="muted small"><%= trip.departure_date %> — <%= trip.departure_time %></p>

          <p style="margin-top:10px;">
            <img src="/icons/arrival.svg" class="inline-icon">
            <strong>To:</strong> <%= trip.arrival_place %>
          </p>
          <p class="muted small"><%= trip.arrival_date %> — <%= trip.arrival_time %></p>
        </div>

        <!-- DRIVER BOX -->
        <div class="detail-box">
          <h3>Driver & Vehicle</h3>

          <p><strong>Driver:</strong> <%= trip.assigned_driver || "-" %></p>
          <p><strong>Driver Phone:</strong> <%= trip.driver_phone || "-" %></p>

          <p style="margin-top:10px;"><strong>Car:</strong> <%= trip.assigned_car || "-" %></p>
          <p><strong>Car Number:</strong> <%= trip.car_number || "-" %></p>
        </div>

        <!-- PAYMENT BOX -->
        <div class="detail-box">
          <h3>Payment</h3>
          <p><strong>Fee:</strong> ₹<%= Number(trip.travelling_fee).toFixed(2) %></p>

          <p><strong>Driver Payment:</strong> <%= trip.driver_payment_status %></p>
          <% if (trip.driver_payment_status) { %>
            <p><strong>Payment Method:</strong> <%= trip.payment_method %></p>
          <% } %>

          <% if (trip.includes_toll) { %>
            <span class="badge badge-yes">
              <img class="badge-icon" src="/icons/toll.svg">
              Toll Included
            </span>
          <% } else { %>
            <span class="badge badge-no">
              <img class="badge-icon" src="/icons/toll.svg">
              Toll Not Included
            </span>
          <% } %>
        </div>
        
        <!-- CAR IMAGES BOX -->
        <div class="detail-box">
          <h3>Car Images</h3>
          <% if (trip.car_images && trip.car_images.length > 0) { %>
            <div class="car-images">
              <% trip.car_images.forEach(function(image) { %>
                <img src="<%= image %>" alt="Car Image" style="max-width: 100%; margin-bottom: 10px;">
              <% }); %>
            </div>
          <% } else { %>
            <p>No car images available.</p>
          <% } %>
        </div>

      </div>

      <p class="muted small" style="margin-top:20px;">
        Created At: <%= trip.created_at %>
      </p>

      <!-- ACTION BUTTONS -->
      <div style="margin-top:20px; display:flex; gap:12px; flex-wrap:wrap;">

        <a class="btn" href="/trips/<%= trip.id %>/edit">✏️ Edit Trip</a>

        <button
         type="button"
         class="btn delete-btn open-delete-modal"
         data-id="<%= trip.id %>">
         🗑 Delete Trip
        </button>

        <a class="btn ghost" href="/trips/<%= trip.id %>/print" target="_blank">🧾 Print / Invoice</a>

      </div>

    </div>
  </div>

  <!-- DELETE CONFIRMATION MODAL -->
  <div id="deleteModal" class="trip-modal-overlay" style="display:none;">
    <div class="trip-modal-box">
      <h3>Delete Trip</h3>
      <p>Are you sure you want to delete this trip? </p>

      <div class="modal-actions">
        <button id="cancelDelete" class="btn ghost">Cancel</button>
        <button id="confirmDeleteBtn" class="btn delete-btn" type="button">Delete</button>
      </div>
    </div>
  </div>

  <script src="/main.js"></script>
  
</body>
</html>
<script>
  window.addEventListener("pageshow", function (event) {
    if (event.persisted) {
      window.location.reload();
    }
  });
</script>
