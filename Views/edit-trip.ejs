<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Edit Driver</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>

  <body>
    <!-- NAVBAR -->
    <div class="navbar">
      <a class="brand" href="/dashboard">
        <img src="/logo.svg" alt="logo" style="height: 28px" />
        <span>Travel Agency</span>
      </a>

      <div class="nav-links">
        <a href="/drivers" class="active">🚗 Drivers</a>
      </div>

      <div class="right-controls">
        <button id="dark-toggle" class="btn ghost">Toggle Dark</button>
      </div>
    </div>

    <!-- MAIN -->
    <div class="container">
      <div class="card">
        <h2>Edit Driver — <%= driver.name %></h2>

        <form
          action="/drivers/<%= driver.id %>/edit"
          method="POST"
          style="margin-top: 14px"
          enctype="multipart/form-data"
        >
          <div class="form-grid">
            <div class="form-row">
              <label>Name</label>
              <input
                type="text"
                name="name"
                value="<%= driver.name %>"
                required
              />
            </div>

            <div class="form-row">
              <label>Phone</label>
              <input type="text" name="phone" value="<%= driver.phone %>" />
            </div>

            <div class="form-row">
              <label>Car</label>
              <input type="text" name="car" value="<%= driver.car %>" />
            </div>

            <div class="form-row">
              <label>Car Number</label>
              <input
                type="text"
                name="car_number"
                value="<%= driver.car_number %>"
              />
            </div>

            <div class="form-row">
              <label>Car Image (Front)</label>
              <input type="file" name="car_image_front" />
            </div>

            <% if (driver.car_image_front) { %>
            <div class="form-row" style="grid-column: 1 / -1">
              <label>Current Car Image (Front)</label>
              <img
                src="/uploads/<%= driver.car_image_front %>"
                alt="car-image-front"
                style="max-width: 250px"
              />
            </div>
            <% } %>

            <div class="form-row">
              <label>Car Image (Back)</label>
              <input type="file" name="car_image_back" />
            </div>

            <% if (driver.car_image_back) { %>
            <div class="form-row" style="grid-column: 1 / -1">
              <label>Current Car Image (Back)</label>
              <img
                src="/uploads/<%= driver.car_image_back %>"
                alt="car-image-back"
                style="max-width: 250px"
              />
            </div>
            <% } %>

            <div class="form-row">
              <label>Car Image (Left)</label>
              <input type="file" name="car_image_left" />
            </div>

            <% if (driver.car_image_left) { %>
            <div class="form-row" style="grid-column: 1 / -1">
              <label>Current Car Image (Left)</label>
              <img
                src="/uploads/<%= driver.car_image_left %>"
                alt="car-image-left"
                style="max-width: 250px"
              />
            </div>
            <% } %>

            <div class="form-row">
              <label>Car Image (Right)</label>
              <input type="file" name="car_image_right" />
            </div>

            <% if (driver.car_image_right) { %>
            <div class="form-row" style="grid-column: 1 / -1">
              <label>Current Car Image (Right)</label>
              <img
                src="/uploads/<%= driver.car_image_right %>"
                alt="car-image-right"
                style="max-width: 250px"
              />
            </div>
            <% } %>

            <div class="form-row">
              <label>License Image</label>
              <input type="file" name="license_image" />
            </div>

            <% if (driver.license_image) { %>
            <div class="form-row" style="grid-column: 1 / -1">
              <label>Current License Image</label>
              <img
                src="/uploads/<%= driver.license_image %>"
                alt="license-image"
                style="max-width: 250px"
              />
            </div>
            <% } %>

            <div class="form-row" style="grid-column: 1 / -1">
              <label>Notes</label>
              <textarea name="notes" style="min-height: 90px"><%= driver.notes %></textarea>
            </div>
          </div>

          <!-- BUTTONS -->
          <div style="margin-top: 18px">
            <button class="btn" type="submit">Update Driver</button>
            <a class="btn ghost" href="/drivers" style="margin-left: 10px">Cancel</a>
          </div>
        </form>
      </div>
    </div>

    <script src="/main.js"></script>
  </body>
</html>

<script>
  window.addEventListener("pageshow", function (event) {
    if (event.persisted) {
      window.location.reload();
    }
  });
</script>
